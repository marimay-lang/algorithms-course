fn same(actual: []int, expected: []int): void {
  expect.equal(actual.length(), expected.length());
  for index in 0..actual.length() {
    expect.equal(actual[index], expected[index]);
  }
}

@test
fn stableOrderAndMultiplicities(): void {
  same(stableUnique([3, -1, 3, 2, -1]), [3, -1, 2]);
  same(stableUnique([]), []);
  same(multisetIntersection([3, 2, 3, 1, 3], [3, 3, 4, 2]), [3, 2, 3]);
  same(multisetIntersection([1], []), []);
  expect.equal(majority([]), None);
  expect.equal(majority([1, 2, 1, 2]), None);
  expect.equal(majority([9, 1, 9, 9]), Some(9));
}

@test
fn pairSearchMatchesQuadraticOracle(): void {
  const extremes = [9223372036854775807, 1, -1];
  expect.none(twoSum(extremes, -9223372036854775807 - 1));
  for seed in 0..30 {
    const values: []int = [];
    for index in 0..7 {
      const _ = values.push((seed + index * index) % 9 - 4);
    }
    for target in -9..10 {
      let exists = false;
      for left in 0..values.length() {
        for right in left + 1..values.length() {
          if values[left] + values[right] == target {
            exists = true;
          }
        }
      }
      match twoSum(values, target) {
        Some(pair) => match pair {
          (left, right) => {
            expect.true(exists);
            expect.true(left >= 0 && left < right && right < values.length());
            expect.equal(values[left] + values[right], target);
          },
        },
        None => expect.false(exists),
      };
    }
  }
}

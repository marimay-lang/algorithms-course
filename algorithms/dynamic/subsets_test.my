fn enumerateKnapsack(weights: []int, values: []int, capacity: int): int {
  let best = 0;
  for mask in 0..smallPower(2, weights.length()) {
    let weight = 0;
    let value = 0;
    for item in 0..weights.length() {
      if (mask >> item & 1) != 0 {
        weight += weights[item];
        value += values[item];
      }
    }
    if weight <= capacity && value > best {
      best = value;
    }
  }
  return best;
}

fn enumerateSubset(values: []int, target: int): bool {
  for mask in 0..smallPower(2, values.length()) {
    let sum = 0;
    for item in 0..values.length() {
      if (mask >> item & 1) != 0 {
        sum += values[item];
      }
    }
    if sum == target {
      return true;
    }
  }
  return false;
}

@test
fn knapsackHandlesZeroWeightsAndExpectedErrors(): void {
  expect.equal(knapsack01([2, 3, 4], [4, 5, 7], 5), Some(9));
  expect.equal(knapsack01([0, 0, 1], [3, 4, 8], 0), Some(7));
  expect.equal(knapsack01([1], [-5], 1), Some(0));
  expect.equal(knapsack01([], [], 0), Some(0));
  expect.none(knapsack01([1], [], 2));
  expect.none(knapsack01([-1], [5], 2));
  expect.none(knapsack01([1], [5], -1));
  expect.none(knapsack01([], [], 9223372036854775807));
  expect.none(knapsack01([0, 0], [9223372036854775807, 1], 0));
}

@test
fn knapsackMatchesAllItemSubsets(): void {
  const weights = [2, 3, 4, 5];
  const values = [3, 4, 5, 8];
  for capacity in 0..12 {
    expect.equal(
      knapsack01(weights, values, capacity),
      Some(enumerateKnapsack(weights, values, capacity)),
    );
  }
}

@test
fn subsetSumHandlesEmptyZeroAndInvalidInputs(): void {
  expect.equal(subsetSum([], 0), Some(true));
  expect.equal(subsetSum([], 1), Some(false));
  expect.equal(subsetSum([0, 0, 2], 2), Some(true));
  expect.equal(subsetSum([3], 6), Some(false));
  expect.none(subsetSum([-1, 2], 1));
  expect.none(subsetSum([1], -1));
  expect.none(subsetSum([], 9223372036854775807));
}

@test
fn subsetSumMatchesExhaustiveSmallSubsets(): void {
  for code in 0..81 {
    const values = sampleVector(4, code, 3, 0);
    for target in 0..10 {
      expect.equal(subsetSum(values, target), Some(enumerateSubset(values, target)));
    }
  }
}

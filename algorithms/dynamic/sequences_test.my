fn enumerateIncreasing(values: []int): int {
  let best = 0;
  for mask in 0..smallPower(2, values.length()) {
    let previous = 0;
    let count = 0;
    let valid = true;
    for index in 0..values.length() {
      if (mask >> index & 1) != 0 {
        if count > 0 && values[index] <= previous {
          valid = false;
        }
        previous = values[index];
        count += 1;
      }
    }
    if valid && count > best {
      best = count;
    }
  }
  return best;
}

fn isSubsequence(candidate: []int, values: []int): bool {
  let matched = 0;
  for value in values {
    if matched < candidate.length() && candidate[matched] == value {
      matched += 1;
    }
  }
  return matched == candidate.length();
}

fn enumerateCommon(left: []int, right: []int): int {
  let best = 0;
  for mask in 0..smallPower(2, left.length()) {
    const candidate = arrayOf<int>();
    for index in 0..left.length() {
      if (mask >> index & 1) != 0 {
        expect.ok(candidate.push(left[index]));
      }
    }
    if candidate.length() > best && isSubsequence(candidate, right) {
      best = candidate.length();
    }
  }
  return best;
}

fn enumerateMaximumSubarray(values: []int): int {
  let best = values[0];
  for start in 0..values.length() {
    let sum = 0;
    for end in start..values.length() {
      sum += values[end];
      if sum > best {
        best = sum;
      }
    }
  }
  return best;
}

@test
fn subsequenceLengthsHaveStrictAndEmptyContracts(): void {
  expect.equal(longestIncreasingSubsequenceLength([]), Some(0));
  expect.equal(longestIncreasingSubsequenceLength([2, 2, 2]), Some(1));
  expect.equal(longestIncreasingSubsequenceLength([3, 1, 2, 5, 4, 6]), Some(4));
  expect.equal(longestCommonSubsequenceLength([], [1]), Some(0));
  expect.equal(longestCommonSubsequenceLength([1, 2, 3], [2, 3, 4]), Some(2));
  expect.equal(longestCommonSubsequenceLength([1, 1], [1]), Some(1));
}

@test
fn increasingSubsequenceMatchesEnumeration(): void {
  for code in 0..81 {
    const values = sampleVector(4, code, 3, -1);
    expect.equal(longestIncreasingSubsequenceLength(values), Some(enumerateIncreasing(values)));
  }
}

@test
fn commonSubsequenceMatchesEnumeration(): void {
  for leftCode in 0..16 {
    const left = sampleVector(4, leftCode, 2, 0);
    for rightCode in 0..16 {
      const right = sampleVector(4, rightCode, 2, 0);
      expect.equal(longestCommonSubsequenceLength(left, right), Some(enumerateCommon(left, right)));
    }
  }
}

@test
fn editDistanceCountsRunesAndUsesUnitEdits(): void {
  expect.equal(levenshteinDistance(scalarInput(""), scalarInput("")), Some(0));
  expect.equal(levenshteinDistance(scalarInput(""), scalarInput("λ🚀")), Some(2));
  expect.equal(levenshteinDistance(scalarInput("kitten"), scalarInput("sitting")), Some(3));
  expect.equal(levenshteinDistance(scalarInput("café"), scalarInput("cafe")), Some(1));
  expect.equal(levenshteinDistance(scalarInput("🚀λ"), scalarInput("λ🚀")), Some(2));
  expect.equal(levenshteinDistance(scalarInput("aλ🚀"), scalarInput("aλ🚀")), Some(0));
  expect.equal(levenshteinDistance(scalarInput("東λ"), scalarInput("λ")), Some(1));
  expect.equal(levenshteinDistance(scalarInput("λ"), scalarInput("東λ")), Some(1));
}

@test
fn maximumSubarrayDefinesNegativeAndOverflowCases(): void {
  expect.none(maximumSubarray([]));
  expect.equal(maximumSubarray([-3, -1, -2]), Some(-1));
  expect.equal(maximumSubarray([-2, 1, -3, 4, -1, 2, 1, -5, 4]), Some(6));
  expect.equal(
    maximumSubarray([-9223372036854775808, -9223372036854775808]),
    Some(-9223372036854775808),
  );
  expect.none(maximumSubarray([9223372036854775807, 1]));
}

@test
fn maximumSubarrayMatchesEverySmallInterval(): void {
  for code in 0..625 {
    const values = sampleVector(4, code, 5, -2);
    expect.equal(maximumSubarray(values), Some(enumerateMaximumSubarray(values)));
  }
}

fn mergeSortRuns(values: []int, output: []int, start: int, middle: int, end: int): void {
  let left = start;
  let right = middle;
  let destination = start;
  while left < middle && right < end {
    if values[left] <= values[right] {
      output[destination] = values[left];
      left += 1;
    } else {
      output[destination] = values[right];
      right += 1;
    }
    destination += 1;
  }
  while left < middle {
    output[destination] = values[left];
    left += 1;
    destination += 1;
  }
  while right < end {
    output[destination] = values[right];
    right += 1;
    destination += 1;
  }
}

// Bottom-up merging avoids dependence on the host's recursive call stack.
public fn mergeSort(values: []int): void {
  const size = length(values);
  if size < 2 {
    return;
  }
  const output = copy(values);
  let width = 1;
  while width < size {
    let start = 0;
    while start < size {
      let middle = size;
      if width < size - start {
        middle = start + width;
      }
      let end = size;
      if width < size - middle {
        end = middle + width;
      }
      mergeSortRuns(values, output, start, middle, end);
      start = end;
    }
    for index in 0..size {
      values[index] = output[index];
    }
    if width > size / 2 {
      return;
    }
    width *= 2;
  }
}

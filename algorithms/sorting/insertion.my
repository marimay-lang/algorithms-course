public fn insertionSort(values: []int): void {
  for index in 1..length(values) {
    const current = values[index];
    let position = index;
    while position > 0 && values[position - 1] > current {
      values[position] = values[position - 1];
      position -= 1;
    }
    values[position] = current;
  }
}

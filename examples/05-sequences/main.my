import { println, Error as IoError } from "std/io";

import * as sequences from "course.local/algorithms/algorithms/sequences";

fn main(): Result<void, IoError> {
  const values = [1, 2, 3, 4, 5];
  if !sequences.rotateLeft(values, 2) || values[0] != 3 || values[4] != 2 {
    panic("rotation");
  }
  const maxima = match sequences.slidingMaximum([1, 3, -1, -3, 5, 3, 6, 7], 3) {
    Some(value) => value,
    None => panic("window"),
  };
  if maxima.length() != 6 || maxima[0] != 3 || maxima[5] != 7 {
    panic("window maxima");
  }
  println("sequences example passed")?;
  return Ok();
}
